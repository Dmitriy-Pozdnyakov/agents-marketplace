<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" compressed="false">
  <diagram id="deployment" name="Выдача в IDP">
    <mxGraphModel dx="1500" dy="590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="590" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="deployment-title" value="Выдача агента в проект" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;fontFamily=Arial;fontColor=#173246;fontStyle=1;fontSize=38;" vertex="1" parent="1">
          <mxGeometry x="52" y="44" width="1396" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="deployment-subtitle" value="Сотрудник заказывает продукт из каталога. IDP автоматически запускает или подключает агента." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;fontFamily=Arial;fontColor=#173246;fontSize=23;" vertex="1" parent="1">
          <mxGeometry x="52" y="118" width="1396" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="deployment-release" value="&lt;b&gt;Команда агентов&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Публикует релиз и спецификацию агента из GitLab.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#8B6CA7;fillColor=#F3EFF8;fontColor=#173246;fontSize=25;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="52" y="238" width="298" height="182" as="geometry"/>
        </mxCell>
        <mxCell id="deployment-catalog" value="&lt;b&gt;Маркетплейс IDP&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Сотрудник выбирает агента и задаёт настройки в карточке.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#648BA7;fillColor=#EAF3FA;fontColor=#173246;fontSize=25;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="418" y="238" width="298" height="182" as="geometry"/>
        </mxCell>
        <mxCell id="deployment-runtime" value="&lt;b&gt;Kubernetes IDP&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Площадка передаёт env и запускает или подключает агента.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#508773;fillColor=#EAF5F1;fontColor=#173246;fontSize=25;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="784" y="238" width="298" height="182" as="geometry"/>
        </mxCell>
        <mxCell id="deployment-resource" value="&lt;b&gt;Ресурс проекта&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot;&gt;После проверки готовности сотрудник открывает страницу или диалог.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#7B8996;fillColor=#F2F4F6;fontColor=#173246;fontSize=25;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1150" y="238" width="298" height="182" as="geometry"/>
        </mxCell>
        <mxCell id="deployment-edge-1" edge="1" parent="1" source="deployment-release" target="deployment-catalog" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;endSize=9;strokeColor=#47657C;strokeWidth=3;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="deployment-edge-2" edge="1" parent="1" source="deployment-catalog" target="deployment-runtime" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;endSize=9;strokeColor=#47657C;strokeWidth=3;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="deployment-edge-3" edge="1" parent="1" source="deployment-runtime" target="deployment-resource" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;endSize=9;strokeColor=#47657C;strokeWidth=3;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="chat" name="Поручение в чате">
    <mxGraphModel dx="1500" dy="590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="590" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="chat-title" value="Создание задачи в GitLab из чата" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;fontFamily=Arial;fontColor=#173246;fontStyle=1;fontSize=38;" vertex="1" parent="1">
          <mxGeometry x="52" y="44" width="1396" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="chat-subtitle" value="Пример поручения сотрудника агенту, готовому к работе в проекте." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;fontFamily=Arial;fontColor=#173246;fontSize=23;" vertex="1" parent="1">
          <mxGeometry x="52" y="118" width="1396" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="chat-employee" value="&lt;b&gt;Сотрудник&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Указывает в чате проект GitLab и задачу, которую нужно создать.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#7B8996;fillColor=#F2F4F6;fontColor=#173246;fontSize=25;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="52" y="238" width="298" height="182" as="geometry"/>
        </mxCell>
        <mxCell id="chat-check" value="&lt;b&gt;Агент&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Проверяет право сотрудника создавать задачи в выбранном проекте.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#8B6CA7;fillColor=#F3EFF8;fontColor=#173246;fontSize=25;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="418" y="238" width="298" height="182" as="geometry"/>
        </mxCell>
        <mxCell id="chat-gitlab" value="&lt;b&gt;GitLab&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Агент создаёт issue в выбранном проекте по поручению сотрудника.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#648BA7;fillColor=#EAF3FA;fontColor=#173246;fontSize=25;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="784" y="238" width="298" height="182" as="geometry"/>
        </mxCell>
        <mxCell id="chat-reply" value="&lt;b&gt;Чат сотрудника&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Агент присылает ссылку на созданную задачу.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#7B8996;fillColor=#F2F4F6;fontColor=#173246;fontSize=25;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1150" y="238" width="298" height="182" as="geometry"/>
        </mxCell>
        <mxCell id="chat-edge-1" edge="1" parent="1" source="chat-employee" target="chat-check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;endSize=9;strokeColor=#47657C;strokeWidth=3;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="chat-edge-2" edge="1" parent="1" source="chat-check" target="chat-gitlab" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;endSize=9;strokeColor=#47657C;strokeWidth=3;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="chat-edge-3" edge="1" parent="1" source="chat-gitlab" target="chat-reply" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;endSize=9;strokeColor=#47657C;strokeWidth=3;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="grafana" name="Алерт Grafana">
    <mxGraphModel dx="1500" dy="590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="590" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="grafana-title" value="Автоматический разбор алерта Grafana" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;fontFamily=Arial;fontColor=#173246;fontStyle=1;fontSize=38;" vertex="1" parent="1">
          <mxGeometry x="52" y="44" width="1396" height="68" as="geometry"/>
        </mxCell>
        <mxCell id="grafana-setup" value="При первом подключении выбирают правило Grafana, привязывают адаптер и канал для отчётов." style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=20;strokeColor=#B8CED9;fillColor=#F1F6F8;fontColor=#213E4D;fontFamily=Arial;fontSize=23;" vertex="1" parent="1">
          <mxGeometry x="52" y="130" width="1396" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="grafana-cycle" value="При каждом срабатывании правила" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;spacing=0;fontFamily=Arial;fontColor=#173246;fontSize=23;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="52" y="240" width="1396" height="49" as="geometry"/>
        </mxCell>
        <mxCell id="grafana-grafana" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Отправляет событие адаптеру.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#508773;fillColor=#EAF5F1;fontColor=#173246;fontSize=25;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="52" y="310" width="244" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="grafana-trigger" value="&lt;b&gt;Адаптер&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot;&gt;При статусе firing запускает разбор.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#648BA7;fillColor=#EAF3FA;fontColor=#173246;fontSize=25;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="340" y="310" width="244" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="grafana-investigation" value="&lt;b&gt;Сервис RCA&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Принимает POST&lt;br&gt;/v1/investigations&lt;br&gt;и проводит разбор.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#8B6CA7;fillColor=#F3EFF8;fontColor=#173246;fontSize=25;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="628" y="310" width="244" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="grafana-deliver" value="&lt;b&gt;Адаптер&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Получает результат и доставляет отчёт RCA.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#648BA7;fillColor=#EAF3FA;fontColor=#173246;fontSize=25;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="916" y="310" width="244" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="grafana-channel" value="&lt;b&gt;Канал&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font style=&quot;font-size:20px&quot;&gt;Дежурные получают отчёт о причине алерта.&lt;/font&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;spacing=12;strokeWidth=2;strokeColor=#7B8996;fillColor=#F2F4F6;fontColor=#173246;fontSize=25;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1204" y="310" width="244" height="168" as="geometry"/>
        </mxCell>
        <mxCell id="grafana-edge-1" edge="1" parent="1" source="grafana-grafana" target="grafana-trigger" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;endSize=9;strokeColor=#47657C;strokeWidth=3;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="grafana-edge-2" edge="1" parent="1" source="grafana-trigger" target="grafana-investigation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;endSize=9;strokeColor=#47657C;strokeWidth=3;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="grafana-edge-3" edge="1" parent="1" source="grafana-investigation" target="grafana-deliver" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;endSize=9;strokeColor=#47657C;strokeWidth=3;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="grafana-edge-4" edge="1" parent="1" source="grafana-deliver" target="grafana-channel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;endArrow=block;endFill=1;endSize=9;strokeColor=#47657C;strokeWidth=3;">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
