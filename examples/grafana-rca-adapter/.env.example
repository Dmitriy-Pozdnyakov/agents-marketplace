# ConfigMap: адрес RCA API и предлагаемый адрес согласованного реестра подключений.
RCA_API_BASE_URL=https://rca.example.invalid
PROFILE_API_BASE_URL=https://profiles.example.invalid

# Secret: значения выдаются экземпляру в проекте IDP.
RCA_API_TOKEN=
GRAFANA_WEBHOOK_TOKEN=
DELIVERY_API_TOKEN=
PROFILE_API_TOKEN=

# Фиксированные значения релиза (fixed).
CONNECTION_CONFIG_PATH=/etc/adapter/connection.yaml
PORT=8080

# Только тестовый Job. ConfigMap: ID источника и ID запуска, общий для его повторов.
SMOKE_FIXTURE_ID=checkout-test-5xx
SMOKE_RUN_ID=conn-checkout-01-smoke-1

# Только тестовый Job. Secret: разрешение на запуск тестового события.
SMOKE_TRIGGER_TOKEN=
